/**
Table maps MIPS64 ELF relocation types to a size in bits.
*/

elf_relocation_size("MIPS64", "NONE", 0).
elf_relocation_size("MIPS64", "16", 16).
elf_relocation_size("MIPS64", "32", 32).
elf_relocation_size("MIPS64", "REL32", 32).
elf_relocation_size("MIPS64", "26", 28).
elf_relocation_size("MIPS64", "HI16", 16).
elf_relocation_size("MIPS64", "LO16", 16).
elf_relocation_size("MIPS64", "GPREL16", 16).
elf_relocation_size("MIPS64", "LITERAL", 16).
elf_relocation_size("MIPS64", "GOT16", 16).
elf_relocation_size("MIPS64", "PC16", 16).
elf_relocation_size("MIPS64", "CALL16", 16).
elf_relocation_size("MIPS64", "GPREL32", 32).
elf_relocation_size("MIPS64", "64", 64).
elf_relocation_size("MIPS64", "GOT_DISP", 16).
elf_relocation_size("MIPS64", "GOT_PAGE", 16).
elf_relocation_size("MIPS64", "GOT_OFST", 16).
elf_relocation_size("MIPS64", "GOT_HI16", 16).
elf_relocation_size("MIPS64", "GOT_LO16", 16).
elf_relocation_size("MIPS64", "SUB", 64).
elf_relocation_size("MIPS64", "HIGHER", 16).
elf_relocation_size("MIPS64", "HIGHEST", 16).
elf_relocation_size("MIPS64", "CALL_HI16", 16).
elf_relocation_size("MIPS64", "CALL_LO16", 16).
elf_relocation_size("MIPS64", "PC18_S3", 18).
elf_relocation_size("MIPS64", "PC19_S2", 19).
elf_relocation_size("MIPS64", "PC21_S2", 21).
elf_relocation_size("MIPS64", "PC26_S2", 26).
elf_relocation_size("MIPS64", "PCHI16", 16).
elf_relocation_size("MIPS64", "PCLO16", 16).
elf_relocation_size("MIPS64", "IRELATIVE", 64).
